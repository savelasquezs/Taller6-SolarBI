        "lineageTag": "b65ff15d-ee88-46b2-bba3-ea7041570c8f",
        "measures": [
          {
            "name": "Solar kWh",
            "expression": "SUM(FactEnergia[solar_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "fc014411-6469-42fb-a65d-3b89edfe2d1b"
          },
          {
            "name": "Carga kWh",
            "expression": "SUM(FactEnergia[carga_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "44016a9c-877a-4dd0-9dc5-df3691c82908"
          },
          {
            "name": "Red importada kWh",
            "expression": "SUM(FactEnergia[red_importada_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "95ea3e1b-99af-4ab0-be31-a9b7b4ef0325"
          },
          {
            "name": "Red exportada kWh",
            "expression": "SUM(FactEnergia[red_exportada_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "19bd1fbd-56c7-4d0e-9309-6a0af88248f0"
          },
          {
            "name": "Batería descarga kWh",
            "expression": "SUM(FactEnergia[bateria_descarga_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "6885445c-0dc0-47f3-8247-2f17b2861bef"
          },
          {
            "name": "Batería carga kWh",
            "expression": "SUM(FactEnergia[bateria_carga_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "5341f637-5bc3-4f9e-85b5-31df85f149f0"
          },
          {
            "name": "Residual DC AC kWh",
            "expression": "SUM(FactEnergia[residual_kwh])",
            "formatString": "#,0.00",
            "lineageTag": "8b0e62b0-1e8d-4ead-be60-defc116eec5c"
          },
          {
            "name": "Rendimiento kWh por kWp",
            "expression": "DIVIDE([Solar kWh],SUM(DimInversor[kwp]))",
            "formatString": "#,0.00",
            "lineageTag": "d542b766-d06e-4c51-a1f6-26b1af176903"
          },
          {
            "name": "Disponibilidad %",
            "expression": "DIVIDE(SUM(FactEnergia[registro_s]),COUNTROWS(FactEnergia)*300)",
            "formatString": "0.0%",
            "lineageTag": "1037f34a-3d2a-4261-b7f2-0b377e6dff40"
          },
          {
            "name": "Lecturas recibidas",
            "expression": "SUM(FactEnergia[lecturas])",
            "formatString": "#,0.00",
            "lineageTag": "bfcd75a2-5360-4173-9035-9a1e9e39823b"
          },
          {
            "name": "Lecturas válidas %",
            "expression": "DIVIDE(SUM(FactEnergia[lecturas_validas]),[Lecturas recibidas])",
            "formatString": "0.0%",
            "lineageTag": "d547b715-c833-45aa-ae09-e20097d21c3d"
          },
          {
            "name": "SoC medio %",
            "expression": "DIVIDE(SUM(FactEnergia[soc_integral]),SUM(FactEnergia[soc_s]))/100",
            "formatString": "0.0%",
            "lineageTag": "76a3a457-d606-4eb2-9dda-e430c1a556be"
          },
          {
            "name": "Tiempo SoC bajo %",
            "expression": "DIVIDE(SUM(FactEnergia[soc_bajo_s]),SUM(FactEnergia[soc_s]))",
            "formatString": "0.0%",
            "lineageTag": "7a2324d3-984a-49f9-bdde-4f4ebc4d4b27"
          },
          {
            "name": "Solar mes anterior",
            "expression": "CALCULATE([Solar kWh],DATEADD(DimFecha[fecha],-1,MONTH))",
            "formatString": "#,0.00",
            "lineageTag": "ff743461-6535-49f5-b607-2793b1d7e5e2"
          },
          {
            "name": "Variación solar mensual %",
            "expression": "DIVIDE([Solar kWh]-[Solar mes anterior],[Solar mes anterior])",
            "formatString": "0.0%",
            "lineageTag": "ca382779-4b45-41ba-9094-28b596725ccf"
          },
          {
            "name": "Tarifa escenario COP",
            "expression": "MAX(Parametros[tarifa_cop_kwh])*(1+SELECTEDVALUE(EscenarioTarifa[Value],0))",
            "formatString": "#,0.00",
            "lineageTag": "4ab69398-17c6-457e-be23-0565544d1c9c"
          },
          {
            "name": "Costo importado COP",
            "expression": "[Red importada kWh]*[Tarifa escenario COP]",
            "formatString": "#,0.00",
            "lineageTag": "cfd44456-4be3-4dc4-95e8-166308b4d315"
          },
          {
            "name": "Eventos",
            "expression": "COUNTROWS(FactEventos)",
            "formatString": "#,0.00",
            "lineageTag": "269b3755-5368-4b76-8ecb-c951684d7a91"
          },
          {
            "name": "Intervalos",
            "expression": "COUNTROWS(FactEnergia)",
            "formatString": "#,0.00",
            "lineageTag": "90d67d4a-c933-48d2-a87b-db70cb597e69"
          },
          {
            "name": "Días incompletos",
            "expression": "COUNTROWS(FILTER(SUMMARIZE(FactEnergia,DimFecha[fecha],DimInversor[inversor]),CALCULATE([Cobertura solar %])<1-0.00000001))",
            "formatString": "#,0.00",
            "lineageTag": "0d619d98-a328-4ec0-90b9-b1a45672984c",
            "description": "Dias con cobertura solar inferior al 100 %, con tolerancia numerica de 0,000001 puntos porcentuales."
          },
          {
            "name": "Cobertura solar %",
            "expression": "DIVIDE(SUM(FactEnergia[solar_s]),COUNTROWS(FactEnergia)*300)",
            "formatString": "0.0%",
            "lineageTag": "bc53952e-4b6d-4014-990a-369950da6781"
          }
        ],
        "partitions": [
          {
            "name": "FactEnergia",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fuente = Odbc.Query(\"dsn=SolarBI\", \"SELECT * FROM gold.fact_energia\")",
                "in Fuente"
              ],
              "type": "m"
            }
          }
        ]
      },
